---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { acquisitionMailto, pageTitle } from '../../lib/constants';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const title = pageTitle('Acquisition Guides for Domain Buyers');
const description =
  'Practical guides on buying premium domain names safely with escrow, valuing descriptive domains, and choosing the right TLD for AI and infrastructure brands.';
const mailto = acquisitionMailto();
---

<BaseLayout title={title} description={description}>
  <Nav home={false} />

  <main id="main" class="pt-28 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl mb-12">
        <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">
          ACQUISITION GUIDES
        </div>
        <h1 class="section-header tracking-[-0.035em] leading-none mb-5">
          Research before you buy.
        </h1>
        <p class="text-lg text-white/70 leading-relaxed">
          Independent, practical reading on premium domain acquisition — escrow,
          valuation, and naming strategy for AI and infrastructure companies.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="modern-card glass rounded-3xl p-8 border border-white/10 hover:border-[#22f5ff]/30 flex flex-col"
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-widest text-white/55 mb-4">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-white/50">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="font-display text-xl sm:text-2xl tracking-tight mb-3 leading-snug">
                {post.data.title}
              </h2>
              <p class="text-sm text-white/60 leading-relaxed">
                {post.data.description}
              </p>
              <span class="mt-auto pt-5 text-sm font-semibold text-[#22f5ff]">
                Read guide →
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-14 glass rounded-3xl border border-white/10 p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center gap-6 justify-between">
        <div>
          <h2 class="font-display text-2xl tracking-tight mb-2">
            Ready to acquire a domain?
          </h2>
          <p class="text-sm text-white/60 max-w-md">
            <span class="text-white font-medium">secureaiframeworks.cloud</span> is
            available at a fixed price with escrow-protected transfer.
          </p>
        </div>
        <a
          href={mailto}
          class="inline-flex items-center justify-center px-8 py-4 min-h-12 rounded-2xl bg-gradient-to-r from-[#22f5ff] to-[#a855f7] text-dark font-bold whitespace-nowrap hover:brightness-105 active:scale-[0.985] transition-all"
        >
          Inquire about the domain
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
