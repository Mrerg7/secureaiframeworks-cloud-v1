---
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
import {
  SITE_NAME,
  HERO_IMAGE_URL,
  GOOGLE_SITE_VERIFICATION,
  PAGE_TITLE,
  PAGE_DESCRIPTION,
  canonicalUrl,
  type FaqItem,
  type ArticleMeta,
} from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  faq?: FaqItem[];
  article?: ArticleMeta;
}

const {
  title = PAGE_TITLE,
  description = PAGE_DESCRIPTION,
  noindex = false,
  faq,
  article,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = HERO_IMAGE_URL;
const themeColor = '#0a0a0f';
const fontInter = '/fonts/inter-latin.woff2';
const fontDisplay = '/fonts/space-grotesk-latin.woff2';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <meta name="keywords" content="buy premium domain, secure AI frameworks domain, AI security domain for sale, enterprise AI security, AI guardrails, trustworthy AI, domain marketplace" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    {noindex ? null : <link rel="canonical" href={canonical} />}
    <meta name="author" content={SITE_NAME} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content="secureaiframeworks.cloud — premium secure AI frameworks domain" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="secureaiframeworks.cloud" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Critical assets: fonts (same-origin, swap) + hero LCP image on the home page -->
    <link rel="preload" href={fontInter} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href={ogImage} as="image" fetchpriority="high" />}
    <link rel="preconnect" href="https://imagedelivery.net" />

    {noindex ? null : <StructuredData title={title} description={description} faq={faq} article={article} />}
  </head>
  <body class="min-h-screen bg-dark text-white antialiased">
    <slot />
  </body>
</html>
