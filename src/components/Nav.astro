---
import { acquisitionMailto } from '../lib/constants';

interface Props {
  /** False on non-home pages so section anchors point back at the landing page. */
  home?: boolean;
}

const { home = true } = Astro.props;
const mailto = acquisitionMailto();
const link = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:px-4 focus:py-2 focus:bg-white focus:text-dark focus:rounded-xl focus:font-semibold"
>
  Skip to content
</a>

<nav id="navbar" aria-label="Main" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex items-center gap-x-3">
        <a href="/" class="flex items-center gap-x-3 min-h-11">
          <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-[#22f5ff] via-[#a855f7] to-[#22f5ff] p-px">
            <div class="w-full h-full bg-dark rounded-2xl flex items-center justify-center">
              <span class="text-[#22f5ff] text-lg font-bold tracking-tighter">SAF</span>
            </div>
          </div>
          <div class="hidden md:block leading-none">
            <span class="font-display text-2xl font-semibold tracking-tighter text-white">secureaiframeworks</span>
            <span class="text-[#22f5ff] font-display text-2xl font-semibold tracking-tighter">.cloud</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-x-7 text-sm font-medium">
        <a href={link('positioning')} class="nav-link text-white/80 hover:text-white py-2">The Opportunity</a>
        <a href={link('why')} class="nav-link text-white/80 hover:text-white py-2">Why This Domain</a>
        <a href={link('uses')} class="nav-link text-white/80 hover:text-white py-2">Ideal For</a>
        <a href={link('faq')} class="nav-link text-white/80 hover:text-white py-2">FAQ</a>
        <a href="/blog/" class="nav-link text-white/80 hover:text-white py-2">Guides</a>
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-x-3">
        <a href={mailto}
           class="hidden sm:inline-flex items-center justify-center min-h-12 px-6 py-2.5 text-sm font-semibold rounded-2xl border border-white/20 hover:bg-white/5 transition-colors text-white">
          Inquire
        </a>
        <a href={mailto}
           class="inline-flex items-center justify-center min-h-12 px-4 sm:px-6 py-2.5 text-sm font-semibold rounded-2xl bg-white text-dark hover:bg-white/90 transition-all active:scale-[0.985]">
          Secure Now
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn"
                class="md:hidden min-w-11 min-h-11 w-11 h-11 flex items-center justify-center text-white/70 hover:text-white transition-colors"
                type="button"
                aria-label="Toggle menu"
                aria-controls="mobile-menu"
                aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-40 bg-dark pt-20 overflow-y-auto">
  <div class="px-6 py-8 flex flex-col gap-y-2 text-lg font-medium">
    <a href={link('positioning')} class="mobile-nav-link min-h-12 flex items-center py-3 text-white/80">The Opportunity</a>
    <a href={link('why')} class="mobile-nav-link min-h-12 flex items-center py-3 text-white/80">Why This Domain</a>
    <a href={link('uses')} class="mobile-nav-link min-h-12 flex items-center py-3 text-white/80">Ideal For</a>
    <a href={link('faq')} class="mobile-nav-link min-h-12 flex items-center py-3 text-white/80">FAQ</a>
    <a href="/blog/" class="mobile-nav-link min-h-12 flex items-center py-3 text-white/80">Guides</a>
    <div class="pt-4 border-t border-white/10">
      <a href={mailto} class="block w-full text-center py-4 min-h-12 rounded-2xl bg-white text-dark font-semibold">Secure This Domain</a>
    </div>
  </div>
</div>

<script>
  // Navbar scroll behavior
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar.style.background = 'rgba(10, 10, 15, 0.95)';
        navbar.style.backdropFilter = 'blur(20px)';
        navbar.style.borderBottom = '1px solid rgba(255, 255, 255, 0.08)';
      } else {
        navbar.style.background = '';
        navbar.style.backdropFilter = '';
        navbar.style.borderBottom = '';
      }
    });
  }

  // Mobile menu toggle
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    const icon = btn.querySelector('svg');
    const hamburger = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />`;
    const closeIcon = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />`;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);
      btn.setAttribute('aria-expanded', String(open));
      if (icon) icon.innerHTML = open ? closeIcon : hamburger;
    };

    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Smooth scroll (skips the skip-link so keyboard focus still moves)
  function initSmoothScroll() {
    document.querySelectorAll('a[href^="#"]:not([href="#main"])').forEach(anchor => {
      anchor.addEventListener('click', function(this: HTMLAnchorElement, e: Event) {
        const id = this.getAttribute('href')?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - 80;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initNavbar(); initMobileMenu(); initSmoothScroll(); });
  } else {
    initNavbar(); initMobileMenu(); initSmoothScroll();
  }
</script>
